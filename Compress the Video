import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        // Write your code here
       


        Scanner sc = new Scanner(System.in);
        
        if (!sc.hasNextInt()) return;
        int t = sc.nextInt();
        
        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];
            
            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }
            
            // Any consecutive identical elements can be reduced to a single element.
            // Therefore, the result is the count of adjacent distinct elements.
            int count = 1;
            for (int i = 1; i < n; i++) {
                if (a[i] != a[i - 1]) {
                    count++;
                }
            }
            
            System.out.println(count);
        }
        
        sc.close();
    }
}
